<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:background="#111820">

        <Button
            android:id="@+id/historyButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:text="☰"
            android:textSize="22sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#21262D" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Chopper AI"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Chopper status/loading logo -->
        <ImageView
            android:id="@+id/statusLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="2dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Chopper status logo"
            android:scaleType="fitCenter" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="" />

    </LinearLayout>

    <!-- CHAT AREA -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:background="#0D1117"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp" />

    </ScrollView>

    <!-- BOTTOM COMPOSER -->
    <LinearLayout
        android:id="@+id/composerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111820"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- MODE ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/modeButton"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:text="Auto ▼"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#30363D" />

        </LinearLayout>

        <!-- INPUT ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:maxHeight="150dp"
                android:minLines="1"
                android:maxLines="5"
                android:hint="Message Chopper..."
                android:textColor="#FFFFFF"
                android:textColorHint="#7D8590"
                android:textSize="16sp"
                android:paddingStart="15dp"
                android:paddingTop="12dp"
                android:paddingEnd="15dp"
                android:paddingBottom="12dp"
                android:gravity="top|start"
                android:background="#21262D"
                android:singleLine="false"
                android:inputType="textCapSentences|textMultiLine"
                android:scrollHorizontally="false"
                android:scrollbars="vertical"
                android:imeOptions="flagNoEnterAction" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="90dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:text="Send"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#238636" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>