<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1115"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chopper"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local AI - Online"
            android:textColor="#8F98A8"
            android:textSize="13sp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/chatText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chopper: Ready."
            android:textColor="#E8EAED"
            android:textSize="17sp"
            android:lineSpacingExtra="5dp"
            android:padding="16dp"
            android:background="#181C23" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:hint="Message Chopper..."
            android:textColorHint="#7E8796"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:background="#1E222A"
            android:singleLine="true"
            android:inputType="text" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="80dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#6C63FF" />

    </LinearLayout>

</LinearLayout>